# AeroNode rev 0.0.2 -- ArduPilot Linux HAL board target
#
# Target: AeroNode HW ver 0.0.2 rev 1, a Raspberry Pi CM5108064B carrier.
# ArduPilot runs NATIVELY on the CM5 (aarch64, no cross-compile, no HAT).
#
# Install as libraries/AP_HAL_Linux/hwdef/aeronode-cm5/hwdef.dat, then
#   ./waf configure --board=aeronode-cm5 && ./waf plane
#
# ---------------------------------------------------------------------------
# WHY THIS INHERITS ../linux AND NOT ../pi5
# ---------------------------------------------------------------------------
# [measured 2026-09-10] The hwdef generator APPENDS sensor device lines and
# `undef` only touches `define`s.  Writing `include ../pi5/hwdef.dat` therefore
# inherited the pi5 dev rig's MPU-9250 as HAL_INS_PROBE1 with the real
# ICM-45686 appended as PROBE2 -- and with INS_MAX_INSTANCES 1 the REAL sensor
# is the one that gets dropped.  `configure` printed "finished successfully"
# the entire time.  Inherit the bare generic board and re-add by hand.
#
# VERIFY EVERY CHANGE TO THIS FILE by reading the GENERATED header, never the
# exit code:
#   grep -E 'HAL_(INS|MAG|BARO)_PROBE_LIST' build/aeronode-cm5/hwdef.h
# ---------------------------------------------------------------------------

include ../linux/hwdef.dat

# RP1 GPIO backend + the subtype that selects UtilRPI, so the board is
# detected as RPI_5.  Requires patches/0001 and 0002 -- see README section 3.
# A CM5 is the same BCM2712 as a Pi 5, so /proc/device-tree/soc*/ranges should
# yield peripheral base 0x10 -> RPI_5.  [derived, NOT measured on a CM5]
#   positive control: the binary prints "RPI 5" at startup.
#   negative control: "Cannot detect board-type" means GPIO is running blind.
define HAL_LINUX_GPIO_RPI_ENABLED 1
define CONFIG_HAL_BOARD_SUBTYPE HAL_BOARD_SUBTYPE_LINUX_PI5

# ---------------------------------------------------------------------------
# IMU -- TDK ICM-45686 on the AeroImu 0.0.2 thermal island, over SPI.
#
# SPI is NOT a preference.  [repo] Both fast_sampling and 20-bit
# highres_sampling are gated on bus_type() == BUS_TYPE_SPI.  On I2C you
# silently get 1 kHz, 16-bit, no oversampling -- and no error.
#
# ROTATION_NONE is a PLACEHOLDER.  It asserts the island is mounted level and
# forward.  That has not been checked against the rev 0.0.2 mechanical drawing.
# Fix it before trusting any attitude output.
# ---------------------------------------------------------------------------
undef HAL_INS_DEFAULT

IMU Invensensev3 SPI:icm45686 ROTATION_NONE
define INS_MAX_INSTANCES 1

# 20-bit HiRes: 16384 LSB/g on the ICM-45686.  No Linux hwdef upstream sets
# this -- ChibiOS boards only, by habit not by gate.  [repo]
define HAL_INS_HIGHRES_SAMPLE 1

# ---------------------------------------------------------------------------
# COMPASS -- Memsic MMC5983MA, driver AP_Compass_MMC5xx3, product ID 0x30.
# [repo] AP_Compass.cpp:1248 probes HAL_COMPASS_MMC5xx3_I2C_ADDR.
# NOTE the driver retries the ID read up to 10 times: it fails intermittently
# on SPI.  Keep this part on I2C.
# ---------------------------------------------------------------------------
COMPASS MMC5XX3 I2C:1:0x30 true ROTATION_NONE
define AP_COMPASS_PROBING_ENABLED 1

# ---------------------------------------------------------------------------
# BARO -- the board carries BOTH.  Declare both; EKF3 will use the first that
# probes and keep the other as a spare instance.
#   BMP581  dedicated driver, I2C 0x46/0x47
#   BMP390  served by AP_Baro_BMP388 -- that driver knows BMP390_ID 0x60
#           alongside BMP388_ID 0x50.  [measured: AP_Baro_BMP388.cpp:28-29]
# ---------------------------------------------------------------------------
BARO BMP581 I2C:1:0x46
BARO BMP388 I2C:1:0x76

# ---------------------------------------------------------------------------
# spidev mapping -- THE ONE THING THAT CANNOT BE DERIVED FROM THE SCHEMATIC.
#
# BUS/SUBDEV are Linux spidev ENUMERATION numbers as they appear under
# /dev/spidev<BUS>.<SUBDEV>.  They are NOT the SoC block numbers SPI3/SPI4 on
# the schematic sheet.  Read them off the real board:
#     scripts/discover-buses.sh
#
# The values below are PLACEHOLDERS carried from the Pi 5 rig and are almost
# certainly wrong for the CM5 carrier.  [gap]
# ---------------------------------------------------------------------------
LINUX_SPIDEV "icm45686" 0 0 SPI_MODE_0 8 SPI_CS_KERNEL 4*MHZ 10*MHZ
