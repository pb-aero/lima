# /etc/systemd/system/co-logger.service — the Blackbox board's CO channel (TGS5141 -> ADS1115 AIN0) once a second:
# CSV at /home/node/aeronode/logs/co.csv + MQTT <prefix>/<device>/co for AeroNode's Live page (a tile appears because
# BB1's config.toml lists `co = 1` under [collector.store_rates]). Indicative ppm only — uncalibrated. See the script.
[Unit]
Description=CO sensor logger (TGS5141 via ADS1115 -> CSV + AeroNode live MQTT)
After=local-fs.target mosquitto.service
Wants=mosquitto.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=node
Group=node
SupplementaryGroups=i2c
ExecStart=/home/node/aeronode/.venv/bin/python -I /home/node/aeronode-scripts/co_logger.py
Restart=always
RestartSec=5
MemoryMax=64M

[Install]
WantedBy=multi-user.target
