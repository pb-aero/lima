From 0ea0cfaa7ee5b72a43554a123fe2923532b733e7 Mon Sep 17 00:00:00 2001
From: Peter Bruce <peter@aerosenseaviation.com>
Date: Fri, 4 Sep 2026 18:08:04 +0200
Subject: [PATCH 2/2] AP_HAL_Linux: pi5 - declare the MPU-9250, LPS22HB and
 AK8963 on i2c-2

Sensors measured on the target: MPU-9250 at 0x68 (WHO_AM_I 0x71), LPS22HB at
0x5c (WHO_AM_I 0xB1), AK8963 behind the MPU aux bus at 0x0c.

Undefs HAL_INS_DEFAULT from the included linux hwdef so the INS probe list
takes effect instead of HAL_INS_NONE.

Rotations are ROTATION_NONE placeholders - the physical mounting has not been
checked.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 libraries/AP_HAL_Linux/hwdef/pi5/hwdef.dat | 37 +++++++++++++++++-----
 1 file changed, 29 insertions(+), 8 deletions(-)

diff --git a/libraries/AP_HAL_Linux/hwdef/pi5/hwdef.dat b/libraries/AP_HAL_Linux/hwdef/pi5/hwdef.dat
index 10ab795c61..3bc2ae600c 100644
--- a/libraries/AP_HAL_Linux/hwdef/pi5/hwdef.dat
+++ b/libraries/AP_HAL_Linux/hwdef/pi5/hwdef.dat
@@ -1,15 +1,36 @@
-# Generic Raspberry Pi 5 (RP1), no autopilot HAT.
+# Generic Raspberry Pi 5 (RP1).
 #
-# Identical to the generic "linux" board -- native toolchain, no IMU/baro/compass
-# declared -- but with the RPi GPIO backend enabled so the board is detected as
-# RPI_5 and GPIO_RPI_RP1 drives the RP1 pads through /dev/gpiomem0.
+# Starts from the generic "linux" board -- native toolchain -- and adds the RPi
+# GPIO backend so the board is detected as RPI_5 and GPIO_RPI_RP1 drives the RP1
+# pads through /dev/gpiomem0.
 #
-# Requires the Util_RPI soc-node fix: on kernels that name the node
-# soc@<addr> rather than plain "soc", detection returns UNKNOWN_BOARD and
-# GPIO_RPI::init() panics.
+# Requires the Util_RPI soc-node fix: on kernels that name the node soc@<addr>
+# rather than plain "soc", detection returns UNKNOWN_BOARD and GPIO_RPI::init()
+# panics.
 
 include ../linux/hwdef.dat
 
 define HAL_LINUX_GPIO_RPI_ENABLED 1
-
 define CONFIG_HAL_BOARD_SUBTYPE HAL_BOARD_SUBTYPE_LINUX_PI5
+
+# ---------------------------------------------------------------------------
+# Sensors, as measured on scopenode 2026-09-04. All on i2c-2.
+#   0x68  MPU-9250        WHO_AM_I 0x71
+#   0x5c  LPS22HB baro    WHO_AM_I 0xB1
+#   0x0c  AK8963 mag, behind the MPU-9250 aux bus
+#
+# ROTATION_NONE is a PLACEHOLDER on all three -- it asserts the sensors are
+# mounted level and forward, which has not been checked. Set to the real
+# orientation before trusting any attitude output.
+# ---------------------------------------------------------------------------
+
+# override HAL_INS_NONE from ../linux/hwdef.dat
+undef HAL_INS_DEFAULT
+
+IMU Invensense I2C:2:0x68 ROTATION_NONE
+define INS_MAX_INSTANCES 1
+
+COMPASS AK8963:probe_mpu9250 I2C:2:0x0c ROTATION_NONE
+define AP_COMPASS_PROBING_ENABLED 1
+
+BARO LPS2XH I2C:2:0x5c
-- 
